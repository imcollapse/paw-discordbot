# Paw configuration
# Copy this file to .env, or set the same names as variables in your hosting panel.
# Only the Required section has to be filled in.

# Required
BOT_TOKEN=
CLIENT_ID=
OWNER_ID=
DATABASE_URL=postgres://user:password@host:5432/dbname

# General
BOT_NAME=paw
PREFIX=,
STATUS=online                # online, idle, dnd or invisible
ACTIVITY_TEXT=paw
SUPPORT_SERVER=              # invite link, used by the support buttons in help and botinfo
WEBSITE=
HELP_BANNER=                 # direct image link shown at the top of the help menu

# Premium links (all optional)
PREMIUM_URL=
VOTE_URL=
PREMIUM_PROMO=
PREMIUM_PAYMENTS=

# Database
DATABASE_SSL=                # true or false, empty detects it
DB_POOL_MAX=10

# Music (Lavalink). Leave LAVALINK_HOSTS empty to run without music.
# For several nodes, comma separate every value in the same order.
LAVALINK_HOSTS=
LAVALINK_PORTS=2333
LAVALINK_PASSWORDS=youshallnotpass
LAVALINK_SECURES=false
MUSIC_DEFAULT_PLATFORM=spsearch    # spsearch needs the LavaSrc plugin, otherwise use ytsearch
MUSIC_AUTOCOMPLETE_LIMIT=10
MUSIC_PLAYLIST_LIMIT=10
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GENIUS_API_KEY=
LASTFM_API_KEY=
LASTFM_API_SECRET=

# AI chat (optional, set the providers you have, they are tried in this order)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NAVY_API_KEY=
# NAVY_BASE_URL=
# GEMINI_MODEL=
# GROQ_MODEL=
# GROQ_VISION_MODEL=
# CEREBRAS_MODEL=
# OPENROUTER_MODEL=
# OPENROUTER_VISION_MODEL=
# NAVY_MODEL=
# NAVY_VISION_MODEL=
# GUARD_AI_MODEL=

# Media tools (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
POLLINATIONS_API_KEY=
SARVAM_API_KEY=
REMOVEBG_API_KEY=

# Social and lookups (optional)
SOCIALCRAWL_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SOCIAL_POLL_MINUTES=15
SERPAPI_API_KEY=
ABUSEIPDB_KEY=
# PINTEREST_COOKIE=          # only if Pinterest blocks your host
# CATBOX_USERHASH=
# IMGLINK_HOST=

# Log channels (optional, channel IDs)
JOIN_LOGS=
LEAVE_LOGS=
ERROR_LOGS=
SLASH_LOGS=
PREFIX_LOGS=
DM_LOGS=

# Security
AUTOMOD_EXEMPT=mods          # mods (Manage Messages), admins or none
